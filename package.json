{
  "name": "siliconhq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sihq": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "check": "tsc --noEmit",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/*.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "prettier": "3.8.3"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.169.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist/",
    "sihq.config.json"
  ]
}
